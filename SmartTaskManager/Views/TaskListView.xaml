<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartTaskManager.ViewModels"
             xmlns:models="clr-namespace:SmartTaskManager.Models"
             x:Class="SmartTaskManager.Views.TaskListView"
             x:DataType="viewmodels:TaskListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Search and Filter Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10">
            <SearchBar Grid.Column="0"
                       Text="{Binding SearchQuery}"
                       Placeholder="Search tasks..."
                       SearchCommand="{Binding SearchTasksCommand}"/>
            
            <Button Grid.Column="1"
                    Text="Filters"
                    Command="{Binding ShowFiltersCommand}"
                    Margin="5,0,0,0"/>
        </Grid>

        <!-- Filter Options -->
        <VerticalStackLayout Grid.Row="1" Padding="10" IsVisible="{Binding ShowFilters}">
            <Label Text="Category" />
            <Picker ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}"
                    ItemDisplayBinding="{Binding Name}"/>

            <Label Text="Status" />
            <Picker ItemsSource="{Binding TaskStatuses}"
                    SelectedItem="{Binding StatusFilter}"/>

            <Label Text="Priority" />
            <Picker ItemsSource="{Binding TaskPriorities}"
                    SelectedItem="{Binding PriorityFilter}"/>

            <Button Text="Clear Filters"
                    Command="{Binding ClearFiltersCommand}"
                    HorizontalOptions="End"/>
        </VerticalStackLayout>

        <!-- Task List -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
            <CollectionView ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask}"
                          SelectionMode="Single">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                       VerticalOptions="Center">
                        <Image Source="empty_tasks.png"
                               HeightRequest="100"
                               WidthRequest="100"/>
                        <Label Text="No tasks found"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Task">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Complete"
                                              Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=MarkTaskCompletedCommand}"
                                              CommandParameter="{Binding .}"
                                              BackgroundColor="Green"/>
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete"
                                              Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskListViewModel}}, Path=DeleteTaskCommand}"
                                              CommandParameter="{Binding .}"
                                              BackgroundColor="Red"/>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Margin="5" Padding="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Description}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Category.Name}"
                                                   TextColor="{Binding Category.Color}"
                                                   FontSize="Small"/>
                                            <Label Text="{Binding DueDate, StringFormat='{0:MMM dd}'}"
                                                   FontSize="Small"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                                       HorizontalOptions="End">
                                        <Label Text="{Binding Priority}"
                                               HorizontalOptions="End"/>
                                        <Label Text="{Binding Status}"
                                               HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add Task Button -->
        <Button Grid.Row="2"
                Text="+"
                Command="{Binding AddTaskCommand}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                HeightRequest="56"
                WidthRequest="56"
                CornerRadius="28"/>
    </Grid>

</ContentPage>