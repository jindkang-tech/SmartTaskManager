<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartTaskManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SmartTaskManager.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Tasks" Icon="task_icon.png">
            <ShellContent
                Title="Tasks"
                ContentTemplate="{DataTemplate views:TaskListView}"
                Route="TaskList" />
        </Tab>

        <Tab Title="Categories" Icon="category_icon.png">
            <ShellContent
                Title="Categories"
                ContentTemplate="{DataTemplate views:CategoryListView}"
                Route="Categories" />
        </Tab>
    </TabBar>

</Shell>